# Copy to .env.local for local development. Never commit real values.
# On the live site these come from GitHub secrets, copied to Cloudflare by the
# deploy workflow. The code reads them only through src/config/env.ts (public)
# and src/config/server-env.ts (secrets).

# ---- Public (safe in the browser) -------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. Safe in the browser: every table has Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public address of the site, e.g. https://vaishnavistores.shop (sitemap, email links).
NEXT_PUBLIC_SITE_URL=

# NOT needed and must NEVER be added anywhere: the service_role / secret key.

# ---- Server secrets (optional features) -------------------------------------
# Shown by SQL part 17. Lets the server read an order once (emails, payments). Must match the database.
NOTIFY_SECRET=

# Order emails (https://resend.com → API Keys, "Sending access").
RESEND_API_KEY=
# Sender after verifying your domain in Resend, e.g. Vaishnavi E-Mart <orders@vaishnavistores.shop>.
# Empty = Resend's test sender (only delivers to your own Resend account email).
EMAIL_FROM=

# Online payment (Razorpay Dashboard → Account & Settings → API Keys). Test keys first (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → URL https://YOUR-DOMAIN/api/razorpay/webhook, events payment.captured + order.paid.
RAZORPAY_WEBHOOK_SECRET=
