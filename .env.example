# Copy to .env.local for local development. On Netlify, add these under
# Site configuration → Environment variables. Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. It is safe in the browser because every
# table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOT needed and must NEVER be added here: the service_role / secret key.

# Public address of the site, e.g. https://vaishnavi-store.netlify.app
# (used in sitemap and in the order-tracking link sent on WhatsApp).
NEXT_PUBLIC_SITE_URL=

# ---- Order emails (Resend, https://resend.com) — optional -------------------
# Resend → API Keys → Create (permission: "Sending access").
RESEND_API_KEY=
# Shown by SQL part 17 when you run it. Lets the website read a new order once to email it.
NOTIFY_SECRET=
# Sender. Leave empty to use Resend's test sender (only delivers to your own
# Resend account email). After verifying your domain in Resend, use e.g.
# Vaishnavi E-Mart <orders@yourdomain.in>
EMAIL_FROM=
